{
  "name": "pi-anchorloop",
  "version": "3.5.0",
  "description": "Agent workflow skills for pi: one entry skill per task type over a short anchor loop (state the check, change, show it passing), plus a close guard and a skill validator.",
  "author": "Wei Hung",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayne930242/anchorloop.git"
  },
  "homepage": "https://github.com/wayne930242/anchorloop#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "anchorloop",
    "agent-workflow",
    "skills",
    "playbooks"
  ],
  "files": [
    "pi",
    "skills",
    "hooks/validate_tool_use.py",
    "hooks/validators/*.py",
    "README.md",
    "README.zh-TW.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./pi/validate-tool-use.ts",
      "./pi/close-guard.ts"
